{
 "version": 1,
 "asOf": "2026-11-03",
 "doc": "Firestore config/moderation 초기 문서 = 앱 assets/data/moderation.json(첫 실행·오프라인용). 규칙은 기획/방명록_금칙어.md v02, 검사 순서는 데이터/check_moderation.py",
 "license": "규칙 L01~L62은 korean_profanity_filter 1.0.0(https://github.com/Xim-ya/korean_profanity_filter, commit 9952105) 정규식을 옮겨 고친 것. MIT License, Copyright (c) 2023 XimYa. 서버 정규식 파일 머리와 앱 오픈소스 라이선스 화면에 MIT 전문을 둔다.",
 "message": "이 표현은 방명록에 남길 수 없어요",
 "normalize": {
  "steps": [
   "fold: NFC·전각→반각·영문 소문자(NFKC 금지)",
   "allow: 허용 단어를 같은 길이 #으로 가림(긴 것부터)",
   "raw 규칙 검사",
   "tight: 닮은꼴 치환 → 한글·자모·영문·#만 남김 → 같은 글자 반복 1개로 → 늘임 모음(ㅇ+앞과 같은 모음) 빼기",
   "tight 규칙 검사: 띄어쓰기를 건너뛴 일치는 낱말 첫머리에서 시작할 때만 인정"
  ],
  "lookalike": {
   "丨": "ㅣ",
   "Ⅰ": "ㅣ",
   "ｌ": "ㅣ"
  }
 },
 "allow": {
  "words": [
   "시발점",
   "시발역",
   "수박씨",
   "발씨",
   "병신년",
   "병신년(丙申年)",
   "시바견",
   "시바이누",
   "도시바",
   "한남동",
   "한남대교",
   "한남역",
   "한남오거리",
   "보충",
   "확충",
   "곤충",
   "해충",
   "기생충",
   "충충",
   "미친듯이",
   "애비뉴",
   "애자일",
   "자위대",
   "자위권",
   "전성기",
   "야스쿠니",
   "떡메치기",
   "개기일식",
   "보존"
  ],
  "auto": [
   "landmarks.name",
   "sigungu.name"
  ]
 },
